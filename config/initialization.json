{
  "config_version": "4.3.0",
  "workspace": {
    "name": "Cross-Project Local Agent Loop",
    "timezone": "Asia/Shanghai",
    "task_root": "E:\\code",
    "project_registry": "E:\\code\\根目录清单.md"
  },
  "database": {
    "path": "data/loop-agent.sqlite3",
    "schema_version": "3.7.0"
  },
  "prompts": {
    "operator": "operator/operator.md",
    "planner": "planner/planner.md",
    "worker": "worker/worker.md",
    "cli_worker": "runner/cli-worker.md"
  },
  "runtime_environments": {
    "codex_automation": {
      "name": "Codex 客户端自动化",
      "entry": {
        "type": "codex_automation",
        "claim_argument": "codex_automation"
      }
    },
    "codex_cli": {
      "name": "Codex CLI",
      "entry": {
        "type": "codex_cli",
        "claim_argument": "codex_cli"
      }
    },
    "self_hosted_agent": {
      "name": "Self-hosted Agent",
      "entry": {
        "type": "self_hosted_agent",
        "claim_argument": "self_hosted_agent"
      }
    }
  },
  "execution_profiles": {
    "codex_automation": {
      "provider_id": null,
      "capabilities": {
        "L1": { "model": "gpt-5.6-luna", "reasoning": "medium", "attempt_timeout_seconds": 3600, "max_retries": 1 },
        "L2": { "model": "gpt-5.6-terra", "reasoning": "medium", "attempt_timeout_seconds": 3600, "max_retries": 1 },
        "L3": { "model": "gpt-5.6-terra", "reasoning": "high", "attempt_timeout_seconds": 3600, "max_retries": 1 },
        "L4": { "model": "gpt-5.6-sol", "reasoning": "high", "attempt_timeout_seconds": 3600, "max_retries": 1 },
        "L5": { "model": "gpt-5.6-sol", "reasoning": "xhigh", "attempt_timeout_seconds": 3600, "max_retries": 1 }
      }
    },
    "codex_cli": {
      "provider_id": null,
      "capabilities": {
        "L1": { "model": "gpt-5.6-luna", "reasoning": "medium", "attempt_timeout_seconds": 3600, "max_retries": 1 },
        "L2": { "model": "gpt-5.6-terra", "reasoning": "medium", "attempt_timeout_seconds": 3600, "max_retries": 1 },
        "L3": { "model": "gpt-5.6-terra", "reasoning": "high", "attempt_timeout_seconds": 3600, "max_retries": 1 },
        "L4": { "model": "gpt-5.6-terra", "reasoning": "xhigh", "attempt_timeout_seconds": 3600, "max_retries": 1 },
        "L5": { "model": "gpt-5.6-sol", "reasoning": "high", "attempt_timeout_seconds": 3600, "max_retries": 1 }
      }
    },
    "self_hosted_agent": {
      "providers": {
        "deepseek": {
          "capabilities": {
            "L1": { "model": "deepseek-v4-flash", "reasoning": "low", "attempt_timeout_seconds": 600, "max_retries": 2 },
            "L2": { "model": "deepseek-v4-flash", "reasoning": "high", "attempt_timeout_seconds": 600, "max_retries": 2 },
            "L3": { "model": "deepseek-v4-pro", "reasoning": "low", "attempt_timeout_seconds": 600, "max_retries": 2 },
            "L4": { "model": "deepseek-v4-pro", "reasoning": "high", "attempt_timeout_seconds": 600, "max_retries": 2 },
            "L5": { "model": "deepseek-v4-pro", "reasoning": "xhigh", "attempt_timeout_seconds": 600, "max_retries": 2 }
          }
        }
      }
    }
  },
  "task_execution": {
    "heartbeat_interval_seconds": 30,
    "stalled_after_seconds": 300,
    "task_lease_seconds": 3600,
    "max_attempts": 2,
    "global_max_active_executions": 8,
    "platform_max_active_executions": {
      "codex_automation": 5,
      "codex_cli": 5,
      "self_hosted_agent": 5
    },
    "scope_conflict_mode": "project",
    "require_human_approval_for": [
      "delete",
      "publish",
      "git_commit",
      "external_message",
      "credential_access"
    ]
  },
  "planner": {
    "execution_kind": "PLANNER",
    "default_runtime_environment": "codex_automation",
    "max_active_executions": 2,
    "heartbeat_interval_seconds": 30,
    "stalled_after_seconds": 300,
    "lease_seconds": 600,
    "attempt_timeout_seconds": 1800,
    "client_boundary": {
      "sandbox": "read-only",
      "approval_policy": "never",
      "network_access": false,
      "default_tool_action": "deny",
      "source_access": "read-only",
      "writeback": {
        "transport": "host_controlled_loopctl_stdin",
        "payload_encoding": "utf-8",
        "integrity_policy": "reject_suspicious_question_mark_corruption",
        "controller": "E:\\code\\local-agent-loop\\control\\loopctl.py",
        "allowed_commands": [
          "preflight-claim",
          "preflight-heartbeat",
          "preflight-ready",
          "preflight-needs-review",
          "preflight-fail"
        ],
        "direct_sql": false,
        "report_files": false
      }
    }
  },
  "self_hosted_agent": {
    "max_steps": 24,
    "max_final_repairs": 1,
    "model_timeout_seconds": 120,
    "tool_timeout_seconds": 120,
    "provider_termination_grace_seconds": 5,
    "max_file_bytes": 524288,
    "max_tool_output_chars": 50000
  },
  "codex_cli": {
    "executable": "codex",
    "prompt": "runner/cli-worker.md",
    "use_user_config": true,
    "sandbox": "workspace-write",
    "termination_grace_seconds": 5,
    "max_stdout_chars": 1000000,
    "max_stderr_chars": 50000,
    "dispatcher": {
      "interval_minutes": 15,
      "task_name": "Local Agent Loop Codex CLI Dispatcher",
      "working_directory": "E:\\code\\local-agent-loop",
      "run_as_current_user": true,
      "timeout_seconds": 7220,
      "log_path": "runtime/codex-cli-dispatcher.log",
      "hidden": true,
      "supported_capability_levels": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    }
  },
  "secret_management": {
    "backend": "os_keyring",
    "service": "Local Agent Loop",
    "access_account": "Admin"
  },
  "deepseek": {
    "api_base_url": "https://api.deepseek.com",
    "model": "deepseek-v4-flash",
    "timeout_seconds": 120,
    "max_retries": 2,
    "retry_backoff_seconds": 1,
    "max_retry_backoff_seconds": 8,
    "secret_ref": "DEEPSEEK_API_KEY",
    "api_key_environment_variable": "DEEPSEEK_API_KEY",
    "supported_execution_profiles": [
      "routine",
      "standard",
      "advanced",
      "deep",
      "complex"
    ]
  },
  "priority_policy": {
    "levels": [
      "blocker",
      "critical",
      "high",
      "medium",
      "low"
    ],
    "project_defaults": {
      "local-agent-loop": "critical"
    }
  },
  "dashboard": {
    "host": "127.0.0.1",
    "port": 4178,
    "poll_interval_ms": 2000,
    "secret_api": {
      "enabled": true,
      "max_body_bytes": 16384,
      "replay_cache_size": 1024
    }
  },
  "automations": {
    "worker_interval_minutes": 20,
    "runtime_environment": "codex_automation",
    "entry_prompt_template": "以 UTF-8 完整读取 E:\\code\\local-agent-loop\\worker\\worker.md，并严格执行；runtime_environment=codex_automation，capability_level={capability_level}，execution_policy=automatic；过渡期 legacy_profile={profile}。",
    "planner": {
      "automation_id": "loop-agent-planner",
      "name": "Loop Agent Planner",
      "scheduled": true,
      "interval_minutes": 5,
      "model": "gpt-5.6-terra",
      "reasoning_effort": "high",
      "runtime_environment": "codex_automation",
      "execution_kind": "PLANNER",
      "sandbox": "read-only",
      "approval_policy": "never",
      "entry_prompt": "以 UTF-8 完整读取 E:\\code\\local-agent-loop\\planner\\planner.md，并严格执行；runtime_environment=codex_automation，execution_kind=PLANNER，sandbox=read-only。"
    },
    "capabilities": {
      "L1": { "name": "Loop Agent Worker · L1", "model": "gpt-5.6-luna", "reasoning_effort": "medium", "execution_policy": "automatic", "automation_id": "loop-agent-worker-routine", "scheduled": true, "offset_minutes": 0, "legacy_profile": "routine" },
      "L2": { "name": "Loop Agent Worker · L2", "model": "gpt-5.6-terra", "reasoning_effort": "medium", "execution_policy": "automatic", "automation_id": "loop-agent-worker-standard", "scheduled": true, "offset_minutes": 2, "legacy_profile": "standard" },
      "L3": { "name": "Loop Agent Worker · L3", "model": "gpt-5.6-terra", "reasoning_effort": "high", "execution_policy": "automatic", "automation_id": "loop-agent-worker-advanced", "scheduled": true, "offset_minutes": 4, "legacy_profile": "advanced" },
      "L4": { "name": "Loop Agent Worker · L4", "model": "gpt-5.6-sol", "reasoning_effort": "high", "execution_policy": "automatic", "automation_id": "loop-agent-worker-deep", "scheduled": true, "offset_minutes": 6, "legacy_profile": "deep" },
      "L5": { "name": "Loop Agent Worker · L5", "model": "gpt-5.6-sol", "reasoning_effort": "xhigh", "execution_policy": "automatic", "automation_id": "loop-agent-worker-complex", "scheduled": true, "offset_minutes": 8, "legacy_profile": "complex" }
    },
    "legacy_profile_compatibility": {
      "routine": "L1",
      "standard": "L2",
      "advanced": "L3",
      "deep": "L4",
      "complex": "L5",
      "exceptional": { "capability_level": "L5", "execution_policy": "manual", "scheduled": false }
    },
    "production_switch": {
      "operator_required": true,
      "status": "active",
      "rollback": {
        "schema_from": "3.3.0",
        "schema_to": "3.4.0",
        "backup_directory": "backups/production-cutover-20260804T175423236+0800",
        "database_backup": "backups/production-cutover-20260804T175423236+0800/loop-agent-schema-3.3.0-before-3.4.0.sqlite3",
        "database_sha256": "8aede6847bd2e3d6034fd3c0500f313c114992c5be6f63e71477c6e22b290860",
        "configuration_backup": "backups/production-cutover-20260804T175423236+0800/initialization.json",
        "configuration_sha256": "d1d451a777e0cb0eb43aaa10ba7f525d4650e67f23775af9190d4d0e96d136d3",
        "requirements": [
          "Pause all five Codex Worker automations before rollback.",
          "Confirm active_executions=0 and that no old client session can still edit.",
          "Restore both the database and initialization configuration from this backup set.",
          "Restart Supervisor through supervisor/main.py health and validate Schema, API, task count, and database integrity before reactivating Workers.",
          "Only Operator may reactivate or modify the five real Codex automations."
        ]
      },
      "checklist": [
        "Confirm old Codex client executions have ended and no stalled session owns the same scope.",
        "Operator updates and verifies the five real automation entries with capability_level parameters.",
        "Keep the 20-minute cadence and 0, 2, 4, 6, 8 minute offsets unchanged.",
        "Confirm every new entry claims once and keep the legacy mapping until Operator closes the transition."
      ]
    },
    "profiles": {
      "routine": {
        "automation_id": "loop-agent-worker-routine",
        "name": "Loop Agent Worker · Routine",
        "model": "gpt-5.6-luna",
        "reasoning_effort": "medium",
        "scheduled": true,
        "offset_minutes": 0
      },
      "standard": {
        "automation_id": "loop-agent-worker-standard",
        "name": "Loop Agent Worker · Standard",
        "model": "gpt-5.6-terra",
        "reasoning_effort": "medium",
        "scheduled": true,
        "offset_minutes": 2
      },
      "advanced": {
        "automation_id": "loop-agent-worker-advanced",
        "name": "Loop Agent Worker · Advanced",
        "model": "gpt-5.6-terra",
        "reasoning_effort": "high",
        "scheduled": true,
        "offset_minutes": 4
      },
      "deep": {
        "automation_id": "loop-agent-worker-deep",
        "name": "Loop Agent Worker · Deep",
        "model": "gpt-5.6-terra",
        "reasoning_effort": "xhigh",
        "scheduled": true,
        "offset_minutes": 6
      },
      "complex": {
        "automation_id": "loop-agent-worker-complex",
        "name": "Loop Agent Worker · Complex",
        "model": "gpt-5.6-sol",
        "reasoning_effort": "high",
        "scheduled": true,
        "offset_minutes": 8
      },
      "exceptional": {
        "automation_id": null,
        "name": "Loop Agent Worker · Exceptional",
        "model": "gpt-5.6-sol",
        "reasoning_effort": "xhigh",
        "scheduled": false,
        "offset_minutes": null
      }
    }
  },
  "health": {
    "scheduler": "windows_task_scheduler",
    "task_name": "Local Agent Loop Health",
    "interval_minutes": 30,
    "failure_threshold": 3
  }
}
