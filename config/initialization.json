{
  "config_version": "5.2.0",
  "workspace": {
    "name": "Cross-Project Local Agent Loop",
    "timezone": "Asia/Shanghai",
    "task_root": "E:\\code",
    "project_registry": "E:\\code\\根目录清单.md"
  },
  "database": {
    "path": "data/loop-agent.sqlite3",
    "schema_version": "3.8.0"
  },
  "prompts": {
    "operator": "operator/operator.md",
    "planner": "planner/planner.md",
    "worker": "worker/worker.md"
  },
  "runtime_environments": {
    "self_hosted_agent": {
      "name": "Self-hosted Agent",
      "entry": {
        "type": "self_hosted_agent",
        "claim_argument": "self_hosted_agent"
      }
    }
  },
  "execution_profiles": {
    "self_hosted_agent": {
      "providers": {
        "deepseek": {
          "capabilities": {
            "L1": { "model": "deepseek-v4-flash", "reasoning": "low", "attempt_timeout_seconds": 600, "max_retries": 2 },
            "L2": { "model": "deepseek-v4-flash", "reasoning": "high", "attempt_timeout_seconds": 600, "max_retries": 2 },
            "L3": { "model": "deepseek-v4-pro", "reasoning": "low", "attempt_timeout_seconds": 600, "max_retries": 2 },
            "L4": { "model": "deepseek-v4-pro", "reasoning": "high", "attempt_timeout_seconds": 600, "max_retries": 2 },
            "L5": { "model": "deepseek-v4-pro", "reasoning": "xhigh", "attempt_timeout_seconds": 600, "max_retries": 2 }
          }
        }
      }
    }
  },
  "task_execution": {
    "heartbeat_interval_seconds": 30,
    "stalled_after_seconds": 300,
    "task_lease_seconds": 3600,
    "max_attempts": 2,
    "global_max_active_executions": 8,
    "platform_max_active_executions": {
      "self_hosted_agent": 8
    },
    "scope_conflict_mode": "project",
    "require_human_approval_for": [
      "delete",
      "publish",
      "git_commit",
      "external_message",
      "credential_access"
    ]
  },
  "planner": {
    "execution_kind": "PLANNER",
    "default_runtime_environment": "self_hosted_agent",
    "provider_id": "deepseek",
    "capability_level": "L3",
    "max_retries": 1,
    "max_active_executions": 2,
    "heartbeat_interval_seconds": 30,
    "stalled_after_seconds": 300,
    "lease_seconds": 600,
    "attempt_timeout_seconds": 1800,
    "scheduler": {
      "scheduled": true,
      "interval_minutes": 5,
      "heartbeat_interval_seconds": 15,
      "runner_log_path": "data/runtime/planner-runner.log"
    },
    "execution_scheduler": {
      "scheduled": true,
      "interval_minutes": 15,
      "working_directory": "E:\\code\\local-agent-loop",
      "log_path": "data/runtime/planner-execution-dispatch.log",
      "runtime_environment": "self_hosted_agent",
      "provider_id": "deepseek",
      "supported_capability_levels": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "client_boundary": {
      "sandbox": "read-only",
      "approval_policy": "never",
      "network_access": false,
      "default_tool_action": "deny",
      "source_access": "read-only",
      "writeback": {
        "transport": "host_controlled_loopctl_stdin",
        "payload_encoding": "utf-8",
        "integrity_policy": "reject_suspicious_question_mark_corruption",
        "controller": "E:\\code\\local-agent-loop\\control\\loopctl.py",
        "allowed_commands": [
          "preflight-claim",
          "preflight-heartbeat",
          "preflight-ready",
          "preflight-needs-review",
          "preflight-fail"
        ],
        "direct_sql": false,
        "report_files": false
      }
    }
  },
  "self_hosted_agent": {
    "provider_factories": {
      "deepseek": "loop_agent.providers.deepseek:create_provider"
    },
    "max_steps": 24,
    "max_final_repairs": 1,
    "model_timeout_seconds": 120,
    "tool_timeout_seconds": 120,
    "provider_termination_grace_seconds": 5,
    "max_file_bytes": 524288,
    "max_tool_output_chars": 50000
  },
  "secret_management": {
    "backend": "os_keyring",
    "service": "Local Agent Loop",
    "access_account": "Admin"
  },
  "deepseek": {
    "api_base_url": "https://api.deepseek.com",
    "model": "deepseek-v4-flash",
    "timeout_seconds": 120,
    "max_retries": 2,
    "retry_backoff_seconds": 1,
    "max_retry_backoff_seconds": 8,
    "secret_ref": "DEEPSEEK_API_KEY",
    "api_key_environment_variable": "DEEPSEEK_API_KEY"
  },
  "priority_policy": {
    "levels": [
      "blocker",
      "critical",
      "high",
      "medium",
      "low"
    ],
    "project_defaults": {
      "local-agent-loop": "critical"
    }
  },
  "dashboard": {
    "host": "127.0.0.1",
    "port": 4178,
    "poll_interval_ms": 2000,
    "heartbeat_interval_seconds": 15,
    "secret_api": {
      "enabled": true,
      "max_body_bytes": 16384,
      "replay_cache_size": 1024
    }
  },
  "health": {
    "scheduler": "windows_task_scheduler",
    "task_name": "Local Agent Loop Health",
    "interval_minutes": 30,
    "failure_threshold": 3,
    "heartbeat_timeout_seconds": 120
  },
  "supervisor": {
    "monitor_interval_seconds": 30,
    "component_start_timeout_seconds": 10,
    "component_stop_timeout_seconds": 5,
    "runner_heartbeat_timeout_seconds": 120,
    "components": {
      "dashboard": {
        "entry": "client/dashboard_server.py",
        "pid_path": "data/runtime/dashboard-server.pid",
        "heartbeat_path": "data/runtime/dashboard-server-heartbeat.json",
        "stop_path": "data/runtime/dashboard-server-stop-request.json",
        "log_path": "data/runtime/dashboard-server.log",
        "heartbeat_timeout_seconds": 60
      },
      "planner": {
        "entry": "planner/main.py",
        "pid_path": "data/runtime/planner.pid",
        "heartbeat_path": "data/runtime/planner-heartbeat.json",
        "stop_path": "data/runtime/planner-stop-request.json",
        "log_path": "data/runtime/planner-scheduler.log",
        "heartbeat_timeout_seconds": 60
      }
    }
  }
}
