# Python 执行和测试产生的字节码缓存，不属于源码，也不能作为运行状态恢复依据。
__pycache__/
*.py[cod]

# 数据目录只跟踪说明文件；附件、备份快照和运行产物不进入版本控制。
data/assets/*
!data/assets/README.md
data/backups/*
!data/backups/README.md
data/runtime/

# SQLite WAL 模式的可重建运行文件；权威任务事实仍是主 sqlite3 文件。
data/*.sqlite3-wal
data/*.sqlite3-shm

# Dashboard 前端依赖和 TypeScript/Vite 中间文件；client/dist 是可直接部署的静态产物。
client/frontend/node_modules/
client/frontend/*.tsbuildinfo
client/frontend/vite.config.js
client/frontend/vite.config.d.ts
